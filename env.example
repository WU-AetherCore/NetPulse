# NetPulse 环境变量配置示例
# 用法：
#   1) 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会提交）；
#   2) 或在 /etc/systemd/system/netpulse.service 中通过 EnvironmentFile=/opt/netpulse/.env 引用，
#      然后执行: sudo systemctl daemon-reload && sudo systemctl restart netpulse

# Web 管理界面登录密码（不设置则使用出厂默认 admin123，首次登录后请务必修改）
NETPULSE_ADMIN_PASSWORD=change-me-to-a-strong-password
